# Formulario de contacto — envío de emails vía Resend
# 1. Crear cuenta en https://resend.com (gratis 3.000 emails/mes)
# 2. Generar API Key y pegarla aquí
# 3. En Vercel: Settings > Environment Variables → añadir las mismas
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email que recibe los leads (por defecto: info@consultoriametodo.es)
CONTACT_TO=info@consultoriametodo.es

# Remitente. Requiere dominio verificado en Resend.
# Mientras no esté verificado, se puede usar "Consultoría Método <onboarding@resend.dev>"
# (solo llegará al email dueño de la API key).
# Una vez verificado consultoriametodo.es en Resend:
#   CONTACT_FROM="Consultoría Método <web@consultoriametodo.es>"
CONTACT_FROM=Consultoría Método <onboarding@resend.dev>
